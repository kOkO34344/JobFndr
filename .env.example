# Copy to .env and fill in. docker compose reads this file automatically.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=jobfndr
POSTGRES_PASSWORD=jobfndr
POSTGRES_DB=jobfndr
# Host port for psql access (container port is always 5432).
POSTGRES_PORT=5433

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- You ---------------------------------------------------------------------
# Seeds the single profile row and the crawler's User-Agent contact address.
# A CV upload overwrites the name/email with whatever it parses.
OPERATOR_NAME=Me
OPERATOR_EMAIL=
OPERATOR_LOCATION=

# --- LLM (proposal drafting) ------------------------------------------------
# Leave LLM_API_KEY empty to use locally generated template drafts.
# Set it and restart the backend to switch to AI-written proposals.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# --- Ranking ----------------------------------------------------------------
RULE_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6

# --- Fetching ---------------------------------------------------------------
# Never set this to false against sites you do not control.
RESPECT_ROBOTS=true
