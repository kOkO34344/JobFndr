# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Secrets and local config
.env
.env.local
*.key

# Runtime data: uploaded CVs, stored artefacts, and your own manual experience.
# data/* rather than data/ so the example file below can be un-ignored — git
# does not descend into an excluded directory.
data/*
!data/manual_experience.example.json

# Personal documents. The app reads your CV via upload at runtime; the
# real-CV tests skip cleanly when it is absent.
cv*.pdf
CV*.pdf
*.docx

# OS
.DS_Store
Thumbs.db
